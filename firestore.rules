// Co-authored-by: Claude Code (Claude Opus 5.5)
// Co-authored-by: Copilot GPT-5.6 Terra
// Co-authored-by: Copilot (Auto)
// Co-authored-by: Copilot Claude Sonnet 5.5
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Sign-up only checks the domain in the app, and anyone can create a Firebase Auth account
    // through the REST API, so the rules check it again.
    function isEpfl() {
      return isSignedIn()
          && request.auth.token.email is string
          && request.auth.token.email.lower().matches('.*@epfl[.]ch$');
    }

    // Everything except creating an account needs a verified EPFL address.
    function isVerified() {
      return isEpfl() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Above zero and at most max, in CHF.
    function isAmount(value, max) {
      return value is number && value > 0 && value <= max;
    }

    // Same bounds as AuthRules.MIN_USERNAME_LENGTH and MAX_USERNAME_LENGTH in the app.
    function validUsernameLength(username) {
      return username is string && username.size() >= 3 && username.size() <= 30;
    }

    // Username -> { uid }. Written once at sign-up, in the same batch as the profile document,
    // before the email is verified. The profile must name this username, so an account can only
    // ever hold one.
    match /usernames/{username} {
      // Sign-up checks availability before the account exists, so this has to work signed out.
      allow get: if true;
      // Sign-in looks up its own username with whereEqualTo("uid", uid).
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isEpfl()
          && validUsernameLength(username)
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && username == username.lower()
          && username == username.trim()
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      allow update, delete: if false;
    }

    // Public profile. The email is not stored here.
    match /users/{uid} {
      // photoPath is a Storage path, not a download URL: a download URL works for anyone who has
      // it, so only storage.rules decides who sees the photo. It can only name the user's own.
      function validProfile(data) {
        return data.keys().hasAll(['username'])
            && validUsernameLength(data.username)
            && data.keys().hasOnly(['username', 'bio', 'photoPath'])
            && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
            && (!('photoPath' in data) || data.photoPath == 'users/' + uid + '/profile.jpg');
      }

      // Other users' profiles are shown next to their listings. Before verifying, a user can
      // still see their own.
      allow read: if isVerified() || isOwner(uid);

      // Part of creating the account, so it does not need a verified email: sign-up writes it
      // before the user has verified. getAfter, because sign-up creates the username in the same
      // batch.
      allow create: if isEpfl() && isOwner(uid)
          && validProfile(request.resource.data)
          && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // Every sign-in rewrites the username it already has (ensureProfileDocument). Before
      // verifying, that write must change nothing.
      allow update: if isOwner(uid)
          && validProfile(request.resource.data)
          && request.resource.data.username == resource.data.username
          && (isVerified() || request.resource.data.diff(resource.data).affectedKeys().size() == 0);

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      function validBooking(data) {
        let listing = get(/databases/$(database)/documents/listings/$(data.listingId)).data;
        return data.keys().hasAll(['listingId', 'renterUid', 'lenderUid', 'startDate', 'endDate', 'status'])
            && data.keys().hasOnly(['listingId', 'renterUid', 'lenderUid', 'startDate', 'endDate', 'status'])
            && data.listingId is string && data.listingId.size() > 0
            && data.renterUid == request.auth.uid
            && data.lenderUid is string
            && data.lenderUid == listing.ownerUid
            && listing.paused == false
            && data.renterUid != data.lenderUid
            // LocalDate epoch days, bounded to the range supported by java.time.LocalDate.
            && data.startDate is int && data.startDate >= -365243219162
            && data.endDate is int && data.endDate <= 365241780471
            // Compare against server time so client clock changes cannot create past bookings.
            && data.startDate >= request.time.toMillis() / 86400000
            && data.startDate <= data.endDate
            // Both ends are inclusive. A listing without maxRentalDays has no limit.
            && (!('maxRentalDays' in listing) || data.endDate - data.startDate + 1 <= listing.maxRentalDays)
            && data.status == 'REQUESTED';
      }

      allow read: if isVerified()
          && (resource.data.lenderUid == request.auth.uid || resource.data.renterUid == request.auth.uid);
      allow create: if isVerified() && validBooking(request.resource.data);
      allow update, delete: if false;
    }

    // One conversation per listing and renter. It is created and bumped only in the same batch as a
    // message: lastMessageId names that message, and the message checks it is the one named.
    match /conversations/{conversationId} {
      function listingPath(listingId) {
        return /databases/$(database)/documents/listings/$(listingId);
      }

      function listingData(listingId) {
        return get(listingPath(listingId)).data;
      }

      function conversationPath() {
        return /databases/$(database)/documents/conversations/$(conversationId);
      }

      // Only a message written by this request has sentAt == request.time: the message rule
      // enforces it, and earlier messages cannot be edited.
      function isNewMessage(messageId) {
        return messageId is string
            && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId)).data.sentAt == request.time;
      }

      // The id is listingId_renterUid. Clients choose listing ids, so ids with more than one '_' are
      // refused, which makes the renter readable from the id before the conversation exists.
      function isRenterInId() {
        let parts = conversationId.split('_');
        return parts.size() == 2 && parts[1] == request.auth.uid;
      }

      function validNewConversation(data) {
        let listing = listingData(data.listingId);
        return data.keys().hasAll(['listingId', 'listingTitle', 'renterUid', 'lenderUid', 'participants', 'lastMessageAt', 'lastMessageId'])
            && data.keys().hasOnly(['listingId', 'listingTitle', 'renterUid', 'lenderUid', 'participants', 'lastMessageAt', 'lastMessageId'])
            && data.listingId is string
            && conversationId == data.listingId + '_' + request.auth.uid
            && isRenterInId()
            && data.renterUid == request.auth.uid
            && data.lenderUid == listing.ownerUid
            && data.renterUid != data.lenderUid
            // Lists the two participants so the inbox can query with array-contains.
            && data.participants == [data.renterUid, data.lenderUid]
            && listing.paused == false
            && data.listingTitle == listing.title
            && data.lastMessageAt == request.time
            && isNewMessage(data.lastMessageId);
      }

      allow get: if isVerified()
          && (isRenterInId() || (resource != null && resource.data.lenderUid == request.auth.uid));
      allow list: if isVerified() && request.auth.uid in resource.data.participants;

      allow create: if isVerified() && validNewConversation(request.resource.data);

      // Each send merges the whole conversation again, so only what a send refreshes may change.
      // A paused listing still accepts messages; a deleted one does not. Checking the owner, not
      // only existence, refuses a listing someone else re-created under the deleted one's id.
      allow update: if isVerified()
          && request.auth.uid in resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'listingTitle', 'lastMessageId'])
          && request.resource.data.lastMessageAt == request.time
          // Also forces lastMessageId to change: the previous message's sentAt is in the past.
          && isNewMessage(request.resource.data.lastMessageId)
          && listingData(resource.data.listingId).ownerUid == resource.data.lenderUid
          && (request.resource.data.listingTitle == resource.data.listingTitle
              || request.resource.data.listingTitle == listingData(resource.data.listingId).title);

      allow delete: if false;

      match /messages/{messageId} {
        // getAfter, because the first message creates the conversation in the same batch. Requiring
        // the conversation to name this message allows one message per batch.
        function validMessage(data) {
          let conversation = getAfter(conversationPath()).data;
          return request.auth.uid in conversation.participants
              && conversation.lastMessageAt == request.time
              && conversation.lastMessageId == messageId
              && data.keys().hasAll(['senderUid', 'text', 'sentAt'])
              && data.keys().hasOnly(['senderUid', 'text', 'sentAt'])
              && data.senderUid == request.auth.uid
              && data.sentAt == request.time
              // The app trims before sending; surrounding whitespace does not count, but is capped.
              && data.text is string
              && data.text.trim().size() >= 1
              && data.text.trim().size() <= 1000
              && data.text.size() <= 2000
              && listingData(conversation.listingId).ownerUid == conversation.lenderUid;
        }

        allow read: if isVerified()
            && (isRenterInId() || get(conversationPath()).data.lenderUid == request.auth.uid);

        allow create: if isVerified() && validMessage(request.resource.data);

        allow update, delete: if false;
      }
    }

    match /listings/{listingId} {
      // Storage paths, not download URLs, as for photoPath. Only the listing's own images/0 to
      // images/4, the paths storage.rules lets its owner write, each at most once: so at most 5.
      function validImagePaths(paths) {
        let folder = 'listings/' + request.auth.uid + '/' + listingId + '/images/';
        return paths is list
            && paths.hasOnly([folder + '0', folder + '1', folder + '2', folder + '3', folder + '4'])
            && paths.toSet().size() == paths.size();
      }

      function validCategory(type, category) {
        return (type == 'ITEM'
                    && category in [
                      'item_tools',
                      'item_electronics',
                      'item_books',
                      'item_sports',
                      'item_kitchen',
                      'item_other'
                    ])
            || (type == 'SERVICE'
                    && category in [
                      'service_tutoring',
                      'service_repairs',
                      'service_moving_help',
                      'service_gardening',
                      'service_cleaning',
                      'service_other'
                    ]);
      }

      function validListing(data) {
        return data.keys().hasAll(['ownerUid', 'category', 'price', 'type', 'title', 'description', 'imagePaths', 'paused'])
            && data.keys().hasOnly(['ownerUid', 'category', 'price', 'type', 'title', 'description', 'imagePaths', 'paused', 'refundValue', 'maxRentalDays'])
            && data.ownerUid == request.auth.uid
            // Required, because Browse queries paused == false and a listing without it would never
            // show. Only the owner can change it, through the update rule below.
            && data.paused is bool
            && data.category is string && validCategory(data.type, data.category)
            // Same as ListingRules.errorFor in the app: no empty or whitespace-only text.
            && data.title is string && data.title.trim().size() > 0 && data.title.size() <= 80
            && data.description is string && data.description.trim().size() > 0
            && data.description.size() <= 1000
            // Same limits as ListingRules.MAX_PRICE and MAX_REFUND_VALUE in the app.
            && isAmount(data.price, 10000)
            && validImagePaths(data.imagePaths)
            && ((data.type == 'ITEM' && isAmount(data.refundValue, 100000))
                || (data.type == 'SERVICE' && !('refundValue' in data)))
            // Optional rental duration in days, items only. Same bounds as
            // ListingRules.MAX_RENTAL_DAYS in the app (a semester, exams included).
            && (!('maxRentalDays' in data)
                || (data.type == 'ITEM' && data.maxRentalDays is int
                    && data.maxRentalDays >= 1 && data.maxRentalDays <= 180));
      }

      allow read: if isVerified();

      allow create: if isVerified() && validListing(request.resource.data);

      allow update: if isVerified()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          // The type decides whether refundValue exists, so a listing keeps the type it was created with.
          && request.resource.data.type == resource.data.type
          && validListing(request.resource.data);

      allow delete: if isVerified() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
