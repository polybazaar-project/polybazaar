rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /usernames/{username} {
      // Username availability is checked in a client-side transaction.
      allow get: if request.auth != null;

      // Users may only query the username document associated with their own UID.
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;

      // A username mapping belongs to the authenticated account that creates it.
      allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'username'])
          && request.resource.data.keys().hasAll(['uid', 'username'])
          && request.resource.data.uid == request.auth.uid;

      // Username mappings are immutable once reserved.
      allow update: if false;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
