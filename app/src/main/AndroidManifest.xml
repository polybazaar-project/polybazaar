<?xml version="1.0" encoding="utf-8"?>
<!-- Co-authored-by: Claude Code (Claude Opus 5.5) -->
<!-- Co-authored-by: Copilot (Auto) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Listing photos are taken with the camera; devices without one can still use the gallery. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- The CAMERA permission also implies autofocus, which fixed-focus cameras lack. -->
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!-- Approximate location only, to centre the map on the renter (#340) and to open the listing
         form's map picker where the lender is (#364). Never sent to the backend; the listing form
         keeps it on the device, in its saved state, so the picker still opens there after the app
         is killed. Without it the user picks their campus instead. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- To know when the device is offline, as choosing a listing's location on the map needs it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PolyBazaarApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PolyBazaar"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.PolyBazaar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Hands the camera app a file to write listing photos into. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Maps key: MAPS_API_KEY from local.properties, else secrets.defaults.properties. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!-- Google Maps' Play Services module still uses Apache HTTP, which Android 9+ no longer
             loads by default: without this the map crashes with NoClassDefFoundError
             org/apache/http/ProtocolVersion (seen on the CI emulator, #391). Not required, so
             devices without the library can still install the app. -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
    </application>

</manifest>